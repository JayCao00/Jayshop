# ===== ProdSeller 供应商 =====
# 供应商 API Key。留空则进入演示模式（demoMode=true）：商品读取本地真实目录
# catalog.json（售价 = 成本价 × (1 + MARKUP_PCT)），但不实际调用供应商下单。
# ⚠️ 真实 Key 只能通过环境变量注入，绝不写进代码或提交到仓库。
PRODSELLER_API_KEY=

# 供应商 API 地址（一般不用改；测试时可指向本地 stub 模拟 402 等场景）
# PRODSELLER_BASE_URL=https://prodseller.com/v1

# ===== 定价 =====
# 加价率（小数）。真实模式下售价 = 成本价 × (1 + MARKUP_PCT)，保留两位小数。
# 演示模式的商品价格已是售价，不受此影响。
MARKUP_PCT=0.30

# USDT→人民币汇率。售价(¥) = 成本价(U) × (1 + MARKUP_PCT) × USDT_CNY_RATE，
# 四舍五入保留 2 位小数。成本核算内部始终用 USDT。
USDT_CNY_RATE=7.2

# ===== 支付宝收款 =====
# 支付宝个人收款码图片地址（客户付款页展示）。
# 两种方式二选一：① 在管理后台 /admin.html 上传（推荐，存在服务器 data/ 目录）；
# ② 填这个环境变量指向一张公网图片 URL。已上传文件时优先使用上传的文件。
# ALIPAY_QR_URL=https://example.com/my-alipay-qr.png

# ===== 币安 USDT 收款（内部转账） =====
# 店主的币安 UID：USDT 订单的付款页会展示此 UID，客户通过币安 App 内
# "UID 转账"（内部转账，免手续费）付款。未设置时 USDT 付款页提示联系店主。
BINANCE_UID=

# ===== 商品分类 / 热门 =====
# 热门商品 id 列表（逗号分隔）：首页"🔥热门"分类展示这些商品。
# 默认含 Gemini Pro、Duolingo、Apple TV、Muse AI；改成你自己的 id 列表即可。
# 商品 id 可在管理后台"商品定价"页看到（或问 Muse 查）。
FEATURED_IDS=6a31035939dc014325da2c66,6aa5bafb77c587d75cbe2a8e,6abeace70dbb401865ffb2d2,6ac65a53d07e0053469f477d

# ===== 管理后台 =====
# 管理员密码。请务必修改！默认 "jayshop-admin" 启动时会打印警告。
ADMIN_PASSWORD=jayshop-admin

# ===== Telegram 新订单通知（可选）=====
# 与 BotFather 创建机器人后得到 token；CHAT_ID 为接收通知的聊天 ID。
BOT_TOKEN=
CHAT_ID=

# ===== 服务 =====
# 监听端口
PORT=3000

# SQLite 数据目录（数据库文件 jayshop.db 存放在此）
DATA_DIR=./data

# 生产环境请设置 NODE_ENV=production（此时 admin cookie 会带 Secure 标记）
# NODE_ENV=production
